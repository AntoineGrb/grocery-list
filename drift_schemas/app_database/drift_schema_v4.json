  "fixed_sql": [
    {
      "name": "articles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"articles\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"normalized_name\" TEXT NOT NULL, \"rayon\" TEXT NOT NULL, \"unit\" TEXT NULL, \"picto_key\" TEXT NOT NULL, \"in_catalogue\" INTEGER NOT NULL DEFAULT 1 CHECK (\"in_catalogue\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "frequents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"frequents\" (\"id\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"article_id\" TEXT NOT NULL REFERENCES articles (id), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
